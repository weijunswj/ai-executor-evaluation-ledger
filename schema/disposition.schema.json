{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:disposition:v1",
  "title": "AI Executor Evaluation Disposition Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "comment_id",
    "comment_body_sha256",
    "disposition",
    "reason",
    "processed_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "comment_id": {"type": "integer"},
    "comment_body_sha256": {"type": "string"},
    "disposition": {
      "type": "string",
      "enum": [
        "already_recorded",
        "duplicate",
        "malformed",
        "conflicted",
        "non_evaluable",
        "owner_withdrawn",
        "ineligible",
        "blocked_controller_action"
      ]
    },
    "reason": {"type": "string"},
    "evaluation_run_id": {"type": ["string", "null"]},
    "processed_at": {"type": "string"}
  },
  "additionalProperties": false
}
