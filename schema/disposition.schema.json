{
  "$id": "urn:ai-executor-evaluation-ledger:disposition:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "comment_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "comment_id": {
          "minimum": 1,
          "type": "integer"
        },
        "disposition": {
          "enum": [
            "already_recorded",
            "duplicate",
            "malformed",
            "conflicted",
            "non_evaluable",
            "owner_withdrawn",
            "ineligible",
            "blocked_controller_action",
            "no_marker",
            "invalid_json",
            "prohibited_identity",
            "pending_controller_action"
          ],
          "type": "string"
        },
        "evaluation_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "processed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "comment_id",
        "comment_body_sha256",
        "disposition",
        "reason",
        "processed_at"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "comment_body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "comment_id": {
          "minimum": 1,
          "type": "integer"
        },
        "disposition_code": {
          "enum": [
            "already_recorded",
            "authority_missing",
            "conflicting_identity",
            "duplicate_identity",
            "ineligible_identity",
            "invalid_schema",
            "no_marker",
            "source_changed",
            "unsafe_content",
            "unsupported_identity",
            "withdrawn_identity"
          ],
          "type": "string"
        },
        "evaluation_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$",
          "type": [
            "string",
            "null"
          ]
        },
        "processed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "comment_id",
        "comment_body_sha256",
        "disposition_code",
        "processed_at"
      ],
      "type": "object"
    }
  ],
  "title": "AI Executor Evaluation Disposition Schema"
}
