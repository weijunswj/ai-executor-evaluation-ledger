{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:manifest:v2",
  "title": "AI Executor Evaluation Manifest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "generated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "manifest_type": {"type": "string", "enum": ["base-model-v2", "evaluation-protocol-v1", "preservation", "reasoning-scrub"]},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "source_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "starting_record_count": {"type": "integer", "minimum": 0},
    "withdrawn_records": {"type": "array", "items": {"type": "string"}},
    "reasoning_only_corrections_removed": {"type": "array", "items": {"type": "string"}},
    "substantive_corrections_preserved": {"type": "array", "items": {"type": "string"}},
    "final_evaluation_count": {"type": "integer", "minimum": 0},
    "final_correction_count": {"type": "integer", "minimum": 0},
    "final_total_count": {"type": "integer", "minimum": 0},
    "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
