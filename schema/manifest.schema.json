{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:manifest:v1",
  "title": "AI Executor Evaluation Manifest Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "manifest_type": {"type": "string"},
    "generated_at": {"type": "string"},
    "source_base_sha": {"type": "string"},
    "starting_record_count": {"type": "integer"},
    "withdrawn_records": {"type": "array"},
    "reasoning_only_corrections_removed": {"type": "array"},
    "substantive_corrections_preserved": {"type": "array"},
    "final_evaluation_count": {"type": "integer"},
    "final_correction_count": {"type": "integer"},
    "final_total_count": {"type": "integer"},
    "before_sha256": {"type": "string"},
    "after_sha256": {"type": "string"}
  },
  "additionalProperties": true
}
