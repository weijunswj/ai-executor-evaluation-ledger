{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:manifest:v2",
  "title": "AI Executor Evaluation Closed Manifest Schema",
  "oneOf": [
    {"$ref": "#/$defs/baseMigration"},
    {"$ref": "#/$defs/correctionMigration"},
    {"$ref": "#/$defs/evaluationProtocol"},
    {"$ref": "#/$defs/historicalAdapter"},
    {"$ref": "#/$defs/preservation"},
    {"$ref": "#/$defs/reasoningScrub"},
    {"$ref": "#/$defs/unicodeIdentityHistoryActivation"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "baseCounts": {
      "type": "object",
      "properties": {
        "source_base_sha": {"$ref": "#/$defs/gitSha"},
        "starting_record_count": {"type": "integer", "minimum": 0},
        "withdrawn_records_count": {"type": "integer", "minimum": 0},
        "withdrawn_records_sha256": {"$ref": "#/$defs/sha256"},
        "removed_or_folded_corrections_count": {"type": "integer", "minimum": 0},
        "removed_or_folded_corrections_sha256": {"$ref": "#/$defs/sha256"},
        "preserved_records_count": {"type": "integer", "minimum": 0},
        "newly_admitted_records_count": {"type": "integer", "minimum": 0},
        "final_evaluation_count": {"type": "integer", "minimum": 0},
        "final_correction_count": {"type": "integer", "minimum": 0},
        "final_total_count": {"type": "integer", "minimum": 0},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "baseMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "manifest_type", "generated_at", "source_base_sha",
        "starting_record_count", "withdrawn_records_count", "withdrawn_records_sha256",
        "removed_or_folded_corrections_count", "removed_or_folded_corrections_sha256",
        "preserved_records_count", "newly_admitted_records_count",
        "final_evaluation_count", "final_correction_count", "final_total_count",
        "before_sha256", "after_sha256", "preserved_base_sha256"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest_type": {"const": "base_model_v2_migration"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "source_base_sha": {"$ref": "#/$defs/gitSha"},
        "starting_record_count": {"type": "integer", "minimum": 0},
        "withdrawn_records_count": {"type": "integer", "minimum": 0},
        "withdrawn_records_sha256": {"$ref": "#/$defs/sha256"},
        "removed_or_folded_corrections_count": {"type": "integer", "minimum": 0},
        "removed_or_folded_corrections_sha256": {"$ref": "#/$defs/sha256"},
        "preserved_records_count": {"type": "integer", "minimum": 0},
        "newly_admitted_records_count": {"type": "integer", "minimum": 0},
        "final_evaluation_count": {"type": "integer", "minimum": 0},
        "final_correction_count": {"type": "integer", "minimum": 0},
        "final_total_count": {"type": "integer", "minimum": 0},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "preserved_base_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "manifest_type", "generated_at", "source_base_sha",
        "starting_record_count", "withdrawn_records_count", "withdrawn_records_sha256",
        "removed_or_folded_corrections_count", "removed_or_folded_corrections_sha256",
        "preserved_records_count", "newly_admitted_records_count",
        "final_evaluation_count", "final_correction_count", "final_total_count",
        "before_sha256", "after_sha256"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest_type": {"const": "canonical_base_preservation_manifest"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "source_base_sha": {"$ref": "#/$defs/gitSha"},
        "starting_record_count": {"type": "integer", "minimum": 0},
        "withdrawn_records_count": {"type": "integer", "minimum": 0},
        "withdrawn_records_sha256": {"$ref": "#/$defs/sha256"},
        "removed_or_folded_corrections_count": {"type": "integer", "minimum": 0},
        "removed_or_folded_corrections_sha256": {"$ref": "#/$defs/sha256"},
        "preserved_records_count": {"type": "integer", "minimum": 0},
        "newly_admitted_records_count": {"type": "integer", "minimum": 0},
        "final_evaluation_count": {"type": "integer", "minimum": 0},
        "final_correction_count": {"type": "integer", "minimum": 0},
        "final_total_count": {"type": "integer", "minimum": 0},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "correctionMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "manifest_type", "generated_at", "source_base_sha",
        "starting_correction_count", "withdrawn_correction_count",
        "withdrawn_corrections_sha256", "removed_or_folded_correction_count",
        "removed_or_folded_corrections_sha256", "preserved_correction_count",
        "preserved_corrections_sha256", "final_correction_count",
        "before_corrections_sha256", "after_corrections_sha256"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest_type": {"const": "correction_migration_manifest"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "source_base_sha": {"$ref": "#/$defs/gitSha"},
        "starting_correction_count": {"type": "integer", "minimum": 0},
        "withdrawn_correction_count": {"type": "integer", "minimum": 0},
        "withdrawn_corrections_sha256": {"$ref": "#/$defs/sha256"},
        "removed_or_folded_correction_count": {"type": "integer", "minimum": 0},
        "removed_or_folded_corrections_sha256": {"$ref": "#/$defs/sha256"},
        "preserved_correction_count": {"type": "integer", "minimum": 0},
        "preserved_corrections_sha256": {"$ref": "#/$defs/sha256"},
        "final_correction_count": {"type": "integer", "minimum": 0},
        "before_corrections_sha256": {"$ref": "#/$defs/sha256"},
        "after_corrections_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluationProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "manifest_type", "generated_at", "evaluations_sha256",
        "total_evaluations", "protocol_counts", "records"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest_type": {"const": "evaluation_protocol_v1"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "evaluations_sha256": {"$ref": "#/$defs/sha256"},
        "total_evaluations": {"type": "integer", "minimum": 0},
        "protocol_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gated_v1": {"type": "integer", "minimum": 0},
            "legacy_pre_gate": {"type": "integer", "minimum": 0},
            "protocol_unknown": {"type": "integer", "minimum": 0}
          }
        },
        "records": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {
            "type": "string",
            "enum": ["gated_v1", "legacy_pre_gate", "protocol_unknown"]
          }
        }
      }
    },
    "historicalAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "manifest_type", "generated_at", "source_base_sha",
        "evaluations_sha256", "final_total_count", "field_aliases",
        "model_aliases", "accepted_verdict_values", "reviewed_at_authority"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest_type": {"const": "historical_intake_adapter_manifest"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "source_base_sha": {"$ref": "#/$defs/gitSha"},
        "evaluations_sha256": {"$ref": "#/$defs/sha256"},
        "final_total_count": {"type": "integer", "minimum": 0},
        "field_aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destination_field", "source_field"],
            "properties": {
              "destination_field": {"type": "string", "minLength": 1},
              "source_field": {"type": "string", "minLength": 1}
            }
          }
        },
        "model_aliases": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "accepted_verdict_values": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reviewed_at_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "batch_id", "source_field", "destination_field",
            "source_comment_count", "source_comment_watermark",
            "source_snapshot_sha256", "requires_body_omission",
            "requires_exact_fingerprint"
          ],
          "properties": {
            "batch_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
            },
            "source_field": {"const": "created_at"},
            "destination_field": {"const": "reviewed_at"},
            "source_comment_count": {"type": "integer", "const": 101},
            "source_comment_watermark": {"type": "integer", "const": 5115014307},
            "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
            "requires_body_omission": {"type": "boolean", "const": true},
            "requires_exact_fingerprint": {"type": "boolean", "const": true}
          }
        }
      }
    },
    "reasoningScrub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "manifest_type", "generated_at", "source_base_sha",
        "evaluations_sha256", "scrubbed_fields_count",
        "removed_attribute_key_count", "removed_correction_count",
        "removed_corrections_sha256"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest_type": {"const": "reasoning_scrub_receipt"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "source_base_sha": {"$ref": "#/$defs/gitSha"},
        "evaluations_sha256": {"$ref": "#/$defs/sha256"},
        "scrubbed_fields_count": {"type": "integer", "minimum": 0},
        "removed_attribute_key_count": {"type": "integer", "minimum": 0},
        "removed_correction_count": {"type": "integer", "minimum": 0},
        "removed_corrections_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unicodeIdentityHistoryActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "manifest_type", "pr_activation_head",
        "canonical_main_base", "generic_history_baseline",
        "pre_activation_occurrence_count",
        "pre_activation_inventory_sha256", "identity_rule_set_sha256"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "manifest_type": {"const": "unicode_identity_history_activation"},
        "pr_activation_head": {
          "allOf": [
            {"$ref": "#/$defs/gitSha"},
            {"const": "10f40ea2f820f4a6230355502639bd7a238b2c45"}
          ]
        },
        "canonical_main_base": {
          "allOf": [
            {"$ref": "#/$defs/gitSha"},
            {"const": "27748b1fa4b70eb69f18047c31ec97c3505beb88"}
          ]
        },
        "generic_history_baseline": {
          "allOf": [
            {"$ref": "#/$defs/gitSha"},
            {"const": "c644a6032dec6709ff08b10f8bfb4fe53de28b69"}
          ]
        },
        "pre_activation_occurrence_count": {
          "type": "integer",
          "const": 571
        },
        "pre_activation_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "identity_rule_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
