{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:receipt:v1",
  "title": "AI Executor Evaluation Receipt Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "batch_id"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "receipt_type": {"type": "string", "enum": ["batch", "cleanup"]},
    "batch_id": {"type": "string", "minLength": 1},
    "controller_run_id": {"type": "string"},
    "controller_authority": {"type": "string"},
    "base_sha": {"type": "string"},
    "pr_number": {"type": ["integer", "null"]},
    "pull_request_number": {"type": ["integer", "null"]},
    "source_comment_watermark": {"type": "integer"},
    "full_queue_count": {"type": "integer"},
    "latest_observed_update_time": {"type": "string"},
    "source_comment_ids": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "source_body_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "admitted_run_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "dispositions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["disposition", "reason"],
        "properties": {
          "disposition": {"type": "string"},
          "reason": {"type": "string"},
          "comment_body_sha256": {"type": "string"},
          "evaluation_run_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "terminal_dispositions": {
      "type": "object"
    },
    "pending_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["comment_id", "reason", "body_sha256"],
        "properties": {
          "comment_id": {"type": "integer"},
          "reason": {"type": "string"},
          "body_sha256": {"type": "string"},
          "created_at": {"type": ["string", "null"]},
          "updated_at": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "cleanup_candidates": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "canonical_record_hashes": {
      "type": "object"
    },
    "analysis_manifest_hash": {"type": "string"},
    "generated_readme_hash": {"type": "string"},
    "generated_scorecard_hash": {"type": "string"},
    "exact_head_sha": {"type": ["string", "null"]},
    "canonical_merge_sha": {"type": "string"},
    "canonical_evaluations_blob_sha": {"type": "string"},
    "deleted_comment_ids": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "deleted_comment_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "retained_comment_ids": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "retained_comment_reasons": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "cleanup_workflow_identity": {"type": "string"},
    "exact_result": {"type": "string"},
    "cleanup_receipt_pr_identity": {"type": "string"},
    "batch_mode": {"type": "string", "enum": ["initial", "incremental"]},
    "queue_snapshot_sha256": {"type": "string"},
    "comment_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "comment_id",
          "author",
          "created_at",
          "updated_at",
          "body_sha256",
          "classification",
          "cleanup_eligible"
        ],
        "properties": {
          "comment_id": {"type": "integer"},
          "author": {"type": ["string", "null"]},
          "created_at": {"type": ["string", "null"]},
          "updated_at": {"type": ["string", "null"]},
          "body_sha256": {"type": "string"},
          "classification": {"type": "string", "enum": ["admitted", "terminal", "pending"]},
          "evaluation_run_id": {"type": ["string", "null"]},
          "canonical_record_sha256": {"type": ["string", "null"]},
          "terminal_disposition": {"type": ["string", "null"]},
          "pending_reason_code": {"type": ["string", "null"]},
          "cleanup_eligible": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "verified_deletion_candidates": {
      "type": "array",
      "items": {"type": "integer"}
    },
    "cleanup_publication_status": {"type": "string"},
    "publication_plan": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"receipt_type": {"const": "batch"}}
      },
      "then": {
        "required": [
          "source_comment_ids",
          "admitted_run_ids",
          "base_sha",
          "source_comment_watermark",
          "full_queue_count",
          "latest_observed_update_time"
        ]
      }
    },
    {
      "if": {
        "properties": {"receipt_type": {"const": "cleanup"}}
      },
      "then": {
        "required": [
          "canonical_merge_sha",
          "canonical_evaluations_blob_sha",
          "deleted_comment_ids",
          "deleted_comment_hashes",
          "retained_comment_ids",
          "retained_comment_reasons",
          "cleanup_workflow_identity",
          "exact_result"
        ]
      }
    }
  ]
}
