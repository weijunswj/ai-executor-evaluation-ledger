{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:intake:v1",
  "title": "AI Executor Evaluation Intake Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "controller_run_id",
    "evaluation_run_id",
    "provider",
    "canonical_base_model",
    "evaluation_protocol",
    "repository_alias",
    "issue_number",
    "source_revision",
    "task_class",
    "difficulty",
    "verdict",
    "score_dimensions",
    "weighted_score_5",
    "public_safe_evidence",
    "secret_exposure_status"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_type": {"type": "string", "const": "evaluation_intake"},
    "controller_run_id": {"type": "string", "minLength": 1},
    "evaluation_run_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "canonical_base_model": {"type": "string", "minLength": 1},
    "evaluation_protocol": {"type": "string", "enum": ["gated_v1", "legacy_pre_gate", "protocol_unknown"]},
    "repository_alias": {"type": "string", "minLength": 1},
    "issue_number": {"type": "integer"},
    "pull_request_number": {"type": ["integer", "null"]},
    "source_revision": {"type": "string", "minLength": 1},
    "task_class": {"type": "string"},
    "difficulty": {"type": "string"},
    "verdict": {"type": "string"},
    "score_dimensions": {"type": "object"},
    "weighted_score_5": {"type": "number"},
    "public_safe_evidence": {"type": "object"},
    "secret_exposure_status": {"type": "string", "enum": ["none", "possible", "confirmed"]}
  },
  "additionalProperties": false
}
