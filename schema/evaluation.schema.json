{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:record:v2",
  "title": "AI Executor Evaluation Record v2",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "reviewed_at",
    "provider",
    "model",
    "evaluation_protocol",
    "task_class",
    "difficulty",
    "subject_alias",
    "revision_binding",
    "outcome",
    "first_pass_accepted",
    "controller_intervention_required",
    "scores",
    "weighted_score_5",
    "confidence"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "record_type": {"type": "string", "enum": ["evaluation", "correction"]},
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor_reported_at": {
      "type": ["string", "null"]
    },
    "provider": {
      "type": "string",
      "enum": ["Google", "DeepSeek", "Qwen", "Anthropic", "OpenAI", "MiMo", "Xiaomi", "MiniMax"]
    },
    "model": {
      "type": "string",
      "enum": [
        "MiMo 2.5 Pro",
        "Claude Opus 4.8",
        "Claude Opus 5",
        "DeepSeek V4 Pro",
        "GPT-5.6 Sol",
        "Qwen3.7 Plus",
        "Gemini 3.1 Pro",
        "Gemini 3.6 Flash",
        "MiniMax M3",
        "Qwen3.6 Plus"
      ]
    },
    "evaluation_protocol": {
      "type": "string",
      "enum": ["gated_v1", "legacy_pre_gate", "protocol_unknown"]
    },
    "task_class": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "subject_alias": {
      "type": "string"
    },
    "revision_binding": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "type": "string",
      "enum": ["accepted", "pass", "rejected", "amend", "hold", "fail", "blocked", "reset", "rescheduled", "error", "owner_withdrawn", "withdrawn"]
    },
    "first_pass_accepted": {"type": "boolean"},
    "controller_intervention_required": {"type": "boolean"},
    "safe_final_state_reported": {"type": ["boolean", "null"]},
    "safe_final_state_verified": {"type": ["boolean", "null"]},
    "root_cause_identified": {"type": ["boolean", "null"]},
    "root_cause_result": {"type": ["string", "null"]},
    "follow_up_runs_required": {"type": ["integer", "null"], "minimum": 0},
    "follow_up_count": {"type": ["integer", "null"], "minimum": 0},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correctness": {"type": "number", "minimum": 0, "maximum": 5},
        "safety_and_scope_control": {"type": "number", "minimum": 0, "maximum": 5},
        "evidence_quality": {"type": "number", "minimum": 0, "maximum": 5},
        "operational_judgement": {"type": "number", "minimum": 0, "maximum": 5},
        "task_understanding": {"type": "number", "minimum": 0, "maximum": 5},
        "tracker_and_repository_hygiene": {"type": "number", "minimum": 0, "maximum": 5},
        "autonomy": {"type": "number", "minimum": 0, "maximum": 5},
        "efficiency": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "weighted_score_5": {"type": "number", "minimum": 0, "maximum": 5},
    "weighted_score_10": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "integrity_and_control_flags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "confidence": {
      "type": "string",
      "enum": ["strong", "verified", "direct", "anecdotal", "provisional", "moderate", "baseline", "high", "medium", "low"]
    },
    "redaction_notice": {"type": ["string", "null"]},
    "verified_strengths": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verified_defects": {
      "type": "array",
      "items": {"type": "string"}
    },
    "controller_verification": {
      "type": "object",
      "additionalProperties": true
    },
    "next_evaluation": {
      "type": ["string", "null"]
    },
    "objective": {
      "oneOf": [
        {
          "type": "array",
          "items": {"type": "string"}
        },
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "prompt_capture": {
      "type": ["string", "null"]
    },
    "reported_operations": {
      "type": "object",
      "additionalProperties": true
    },
    "affected_run_id": {
      "type": "string"
    },
    "corrected_fields": {
      "type": "object",
      "additionalProperties": true
    },
    "correction_reason": {
      "type": "string"
    },
    "correction_scope": {
      "type": "string"
    },
    "verification_evidence": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
