{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:record:v2",
  "title": "AI Executor Evaluation Record v2",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "reviewed_at",
    "provider",
    "model",
    "evaluation_protocol",
    "task_class",
    "difficulty",
    "subject_alias",
    "revision_binding",
    "outcome",
    "first_pass_accepted",
    "controller_intervention_required",
    "scores",
    "weighted_score_5",
    "confidence"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "record_type": {"type": "string", "enum": ["evaluation", "correction"]},
    "run_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string"},
    "executor_reported_at": {"type": ["string", "null"]},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "evaluation_protocol": {
      "type": "string",
      "enum": ["gated_v1", "legacy_pre_gate", "protocol_unknown"]
    },
    "task_class": {
      "type": "string",
      "enum": [
        "research",
        "routine-repository-change",
        "complex-repository-change",
        "security-review",
        "security-remediation",
        "migration",
        "provider-operation",
        "production-deployment",
        "incident-diagnosis",
        "tracker-reconciliation",
        "implementation-amendment",
        "provider-admission",
        "credential-containment",
        "ux-remediation"
      ]
    },
    "difficulty": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "subject_alias": {"type": "string"},
    "revision_binding": {"type": "string", "minLength": 1},
    "prompt_sha256": {
      "type": ["string", "null"]
    },
    "outcome": {"type": "string", "enum": ["accepted", "amend", "hold", "fail", "blocked"]},
    "first_pass_accepted": {"type": "boolean"},
    "controller_intervention_required": {"type": "boolean"},
    "safe_final_state_reported": {"type": ["boolean", "null"]},
    "safe_final_state_verified": {"type": ["boolean", "null"]},
    "root_cause_identified": {"type": ["boolean", "null"]},
    "follow_up_runs_required": {"type": ["integer", "null"], "minimum": 0},
    "scores": {
      "type": "object",
      "required": [
        "correctness",
        "safety_and_scope_control",
        "evidence_quality",
        "operational_judgement",
        "task_understanding",
        "tracker_and_repository_hygiene",
        "autonomy",
        "efficiency"
      ],
      "additionalProperties": false,
      "properties": {
        "correctness": {"type": "number", "minimum": 0, "maximum": 5},
        "safety_and_scope_control": {"type": "number", "minimum": 0, "maximum": 5},
        "evidence_quality": {"type": "number", "minimum": 0, "maximum": 5},
        "operational_judgement": {"type": "number", "minimum": 0, "maximum": 5},
        "task_understanding": {"type": "number", "minimum": 0, "maximum": 5},
        "tracker_and_repository_hygiene": {"type": "number", "minimum": 0, "maximum": 5},
        "autonomy": {"type": "number", "minimum": 0, "maximum": 5},
        "efficiency": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "weighted_score_5": {"type": "number", "minimum": 0, "maximum": 5},
    "weighted_score_10": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "integrity_and_control_flags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "confidence": {"type": "string", "enum": ["anecdotal", "provisional", "moderate", "baseline"]},
    "redaction_notice": {"type": ["string", "null"]},
    "verified_strengths": {},
    "verified_defects": {},
    "controller_verification": {},
    "next_evaluation": {},
    "objective": {"type": "string"},
    "prompt_capture": {},
    "reported_operations": {},
    "affected_run_id": {"type": "string"},
    "corrected_fields": {"type": "object"},
    "correction_reason": {"type": "string"},
    "correction_scope": {"type": "string"},
    "verification_evidence": {}
  },
  "additionalProperties": false
}
