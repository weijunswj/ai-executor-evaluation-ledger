{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-executor-evaluation-ledger:review-result:v2",
  "title": "Public-Safe Review Result",
  "type": "object",
  "required": [
    "schema_version",
    "result_type",
    "review_job_id",
    "batch_id",
    "reviewed_at",
    "rulebook_sha"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "result_type": {
      "type": "string",
      "enum": ["evaluated", "blocked", "administrative"]
    },
    "review_job_id": {
      "type": "string",
      "pattern": "^RJ-[0-9]{8}-[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^BATCH-[0-9]{8}-[0-9]{3}$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rulebook_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "evaluation_record": {
      "type": "object"
    },
    "blocked_reason_code": {
      "type": ["string", "null"],
      "enum": [
        "intake_missing",
        "duplicate_job_id",
        "intake_body_changed",
        "invalid_schema",
        "missing_model_identity",
        "missing_source_revision",
        "conflicting_duplicate_run_id",
        "source_inaccessible",
        "source_head_missing",
        "private_evidence_unavailable",
        "material_evidence_conflict",
        "review_too_large",
        "dependent_job_blocked",
        null
      ]
    },
    "verdict": {
      "type": ["string", "null"],
      "enum": ["accepted", "amend", "hold", "fail", null]
    },
    "weighted_score_5": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 5
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "provider": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "subject_alias": {
      "type": ["string", "null"]
    },
    "operation_class": {
      "type": ["string", "null"]
    },
    "is_correction": {
      "type": "boolean"
    },
    "correction_target_run_id": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "result_type": {
        "const": "evaluated"
      }
    }
  },
  "then": {
    "required": ["verdict", "weighted_score_5", "run_id", "evaluation_record"]
  },
  "else": {
    "if": {
      "properties": {
        "result_type": {
          "const": "blocked"
        }
      }
    },
    "then": {
      "required": ["blocked_reason_code"]
    }
  }
}
